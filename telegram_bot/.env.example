# Genera un token nuevo en @BotFather y colócalo solo en tu entorno local o servidor.
BOT_TOKEN=pega_aqui_un_token_nuevo
SQLITE_PATH=bot_database.db
COOLDOWN_SECONDS=15
MAX_CONCURRENT_SEARCHES=4
SEARCH_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
# Opcional: IDs de Telegram separados por comas. Vacío = /stats público.
ADMIN_USER_IDS=
